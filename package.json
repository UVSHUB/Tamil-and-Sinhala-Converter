{
  "name": "sinhala-tamil-voice-translator",
  "version": "1.0.0",
  "description": "Real-time AI Sinhala ↔ Tamil Voice Translator using Gemini Live API",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "dev:backend": "node scripts/dev-backend.js",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "voice-translator",
    "gemini-live-api",
    "real-time-translation",
    "sinhala",
    "tamil",
    "fastapi",
    "react",
    "websockets"
  ],
  "author": "Translator Project Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
